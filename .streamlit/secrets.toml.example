# Streamlit secrets for the EDA chatbot.
#
# HOW TO USE:
#   1. Rename this file to:   secrets.toml   (keep it inside the .streamlit folder)
#   2. Paste your free Groq key below (get one at https://console.groq.com/keys).
#   3. Restart the app. The key field in the sidebar will auto-fill.
#
# Only fill in the provider you actually use. Never commit your real key.

GROQ_API_KEY = "gsk_paste_your_free_groq_key_here"

# Optional alternatives:
# GOOGLE_API_KEY = "paste_your_free_gemini_key_here"
# OPENAI_API_KEY = "sk_paste_your_openai_key_here"
